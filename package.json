{
  "name": "cliowrapper",
  "displayName": "BPM Remote Toolkit",
  "description": "Development and remote toolkit for BPMSoft and Creatio.",
  "icon": "images/icon.png",
  "publisher": "code-papery",
  "version": "1.8.19",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsWelcome": [
      {
        "view": "bpmEnvironments",
        "contents": "Add environments to you .code-workspace file."
      },
      {
        "view": "packagesExplorer",
        "contents": "Add folders from File Explorer."
      },
      {
        "view": "packageDeploymentManagement",
        "contents": "No packages for deployment.\nAdd packages from Packages Explorer."
      }
    ],
    "colors": [
      {
        "id": "bpmEnvironment.enable",
        "description": "If environment is enable.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green"
        }
      },
      {
        "id": "bpmEnvironment.disable",
        "description": "If environment is enable.",
        "defaults": {
          "dark": "charts.red",
          "light": "charts.red"
        }
      },
      {
        "id": "packageDeploymentManagement.successCompleted",
        "description": "Package deployment is success.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green"
        }
      },
      {
        "id": "packageDeploymentManagement.errorCompleted",
        "description": "Package deployment is error.",
        "defaults": {
          "dark": "charts.red",
          "light": "charts.red"
        }
      }
    ],
    "views": {
      "scm": [
        {
          "id": "bpmEnvironments",
          "name": "Bpm Environments"
        },
        {
          "id": "packagesExplorer",
          "name": "Packages Explorer"
        },
        {
          "id": "packageDeploymentManagement",
          "name": "Package Deployment Management"
        }
      ]
    },
    "configuration": {
      "title": "BPM Remote Toolkit",
      "properties": {
        "bpmtoolkit.general.utility": {
          "order": 0,
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "clio",
            "ubs"
          ],
          "enumDescriptions": [
            "Automatic utility detection.",
            "Service program for remote work with Creatio.",
            "Service program for remote work with BPMSoft."
          ],
          "scope": "application"
        },
        "bpmtoolkit.general.autoUpdateTime": {
          "order": 1,
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "When saving changes to cs or js files, automatically updates the ModifiedOnUtc field in the Descriptor.json file."
        },
        "bpmtoolkit.general.packToZip": {
          "order": 2,
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "If this option is enabled, the generated package will be packed into a zip file."
        }
      }
    },
    "commands": [
      {
        "command": "bpmEnvironments.refreshEntry",
        "title": "Refresh"
      },
      {
        "command": "packagesExplorer.refreshEntry",
        "title": "Refresh"
      },
      {
        "command": "packageDeploymentManagement.refreshEntry",
        "title": "Refresh"
      },
      {
        "command": "explorer.folder.addPackage",
        "title": "Add Folder To Packages Explorer"
      },
      {
        "command": "bpmEnvironments.openSettings",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "packagesExplorer.openLastLog",
        "title": "Open last log",
        "icon": "$(output)"
      },
      {
        "command": "bpmEnvironments.server.restart",
        "title": "Restart application"
      },
      {
        "command": "bpmEnvironments.server.redisClear",
        "title": "Clear redis database"
      },
      {
        "command": "bpmEnvironments.server.compileConfiguration",
        "title": "Compile configuration"
      },
      {
        "command": "bpmEnvironments.server.register",
        "title": "Register",
        "icon": "$(plug)"
      },
      {
        "command": "bpmEnvironments.server.unregister",
        "title": "Unregister",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "packagesExplorer.createPackageWithProgress",
        "title": "Create Package",
        "icon": "$(repo-pull)"
      },
      {
        "command": "packagesExplorer.deployPackageToSelectedServer",
        "title": "Create Package And Send",
        "icon": "$(repo-force-push)"
      },
      {
        "command": "packagesExplorer.package.addDeployment",
        "title": "Add package to deployment",
        "icon": "$(add)"
      },
      {
        "command": "packagesExplorer.package.remove",
        "title": "Remove from Packages Explorer",
        "icon": "$(x)"
      },
      {
        "command": "packageDeploymentManagement.startDeployment",
        "title": "Start deployment",
        "icon": "$(play)"
      },
      {
        "command": "packageDeploymentManagement.clear",
        "title": "Clear",
        "icon": "$(x)"
      },
      {
        "command": "bpmnViewer.start",
        "title": "Open BPMN Viewer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "explorer.folder.addPackage",
          "when": "explorerResourceIsFolder && isShowContextMenu",
          "group": "z_cliowrapper@3"
        }
      ],
      "view/title": [
        {
          "command": "bpmEnvironments.openSettings",
          "when": "view == bpmEnvironments",
          "group": "navigation@1"
        },
        {
          "command": "packagesExplorer.openLastLog",
          "when": "view == packagesExplorer",
          "group": "navigation@1"
        },
        {
          "command": "packageDeploymentManagement.startDeployment",
          "when": "view == packageDeploymentManagement && isShowStartDeploymentCommand",
          "group": "navigation@1"
        },
        {
          "command": "packageDeploymentManagement.clear",
          "when": "view == packageDeploymentManagement && isShowClearDeploymentCommand",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "bpmEnvironments.server.restart",
          "when": "view == bpmEnvironments && viewItem == serverTreeItemUnregister && isShowContextMenu",
          "group": "navigation@1"
        },
        {
          "command": "bpmEnvironments.server.compileConfiguration",
          "when": "view == bpmEnvironments && viewItem == serverTreeItemUnregister && isShowContextMenu",
          "group": "navigation@2"
        },
        {
          "command": "bpmEnvironments.server.redisClear",
          "when": "view == bpmEnvironments && viewItem == serverTreeItemUnregister && isShowContextMenu",
          "group": "cw_other@2"
        },
        {
          "command": "bpmEnvironments.server.register",
          "when": "view == bpmEnvironments && viewItem == serverTreeItemRegister && isShowContextMenu",
          "group": "inline@1"
        },
        {
          "command": "bpmEnvironments.server.unregister",
          "when": "view == bpmEnvironments && viewItem == serverTreeItemUnregister && isShowContextMenu",
          "group": "inline@2"
        },
        {
          "command": "packagesExplorer.createPackageWithProgress",
          "when": "view == packagesExplorer && viewItem == packageTreeItemEnable && isShowContextMenu",
          "group": "inline@1"
        },
        {
          "command": "packagesExplorer.deployPackageToSelectedServer",
          "when": "view == packagesExplorer && viewItem == packageTreeItemEnable && isShowContextMenu",
          "group": "inline@2"
        },
        {
          "command": "packagesExplorer.package.addDeployment",
          "when": "view == packagesExplorer && isShowContextMenu",
          "group": "pe_other@1"
        },
        {
          "command": "packagesExplorer.package.remove",
          "when": "view == packagesExplorer && isShowContextMenu",
          "group": "pe_other@2"
        }
      ]
    }
  },
  "scripts": {
    "all": "run-s lint test",
    "lint": "eslint .",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce pack",
    "compile": "run-s compile:app compile:other copy:testJson copy:testXml",
    "compile:app": "rollup -c rollup.config.mjs",
    "compile:other": "tsc -p ./",
    "compile:clean": "shx rm -rf out",
    "copy:testJson": "shx cp src/test/metadata.json out/test/metadata.json",
    "copy:testXml": "shx cp src/test/resource.ru-RU.xml out/test/resource.ru-RU.xml",
    "watch:app": "npm run compile:app -- -w",
    "watch": "run-p watch:*",
    "pretest": "run-s compile",
    "test": "node ./out/test/run-tests.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.44",
    "@types/vscode": "^1.85.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "dependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-url": "^8.0.2",
    "bpmn-js": "^18.4.0",
    "bpmn-moddle": "^9.0.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.40.0",
    "rollup-plugin-css-only": "^4.5.2",
    "shx": "^0.4.0",
    "xml2js": "^0.6.2"
  }
}
