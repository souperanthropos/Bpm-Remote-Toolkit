{
  "name": "bpmsoft-creator-package",
  "displayName": "Bpmsoft Creator Package",
  "description": "Helper for creating Bpmsoft package",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Bpmsoft Creator Package",
      "properties": {
        "bcp.outputPath": {
          "type": "string",
          "default": "C:\\",
          "scope": "resource",
          "description": "Specify output full path for .gz file."
        },
        "bcp.remoteTestServerLogin": {
          "type": "string",
          "default": "admin",
          "scope": "resource",
          "description": "Bpmsoft account login for test server."
        },
        "bcp.remoteTestServerPassword": {
          "type": "string",
          "default": "admin",
          "scope": "resource",
          "description": "Bpmsoft account password for test server."
        }
      }
    },
    "commands": [
      {
        "command": "bpmsoft-creator-package.create",
        "title": "Create Package"
      },
      {
        "command": "bpmsoft-creator-package.test.createandsend",
        "title": "Create Package And Send To Test Server"
      }
    ],
    "menus": {
      "explorer/context": [
          {
              "when": "explorerResourceIsFolder",
              "command": "bpmsoft-creator-package.create"
          },
          {
            "when": "explorerResourceIsFolder",
            "command": "bpmsoft-creator-package.test.createandsend"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}
