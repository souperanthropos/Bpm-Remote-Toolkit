{
  "name": "cliowrapper",
  "displayName": "Clio Wrapper",
  "description": "Wrapper for CI/CD tools.",
  "icon": "images/icon.png",
  "publisher": "code-papery",
  "version": "1.3.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Clio wrapper",
      "properties": {
        "clio.outputPath": {
          "order": 0,
          "type": "string",
          "default": "C:\\",
          "scope": "application",
          "description": "Specify output full path for .gz file."
        },
        "clio.bpmSoft.test.login": {
          "order": 1,
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Bpmsoft account login for test app."
        },
        "clio.bpmSoft.test.password": {
          "order": 2,
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Bpmsoft account password for test app."
        },
        "clio.bpmSoft.preprod.login": {
          "order": 3,
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Bpmsoft account login for preprod app."
        },
        "clio.bpmSoft.preprod.password": {
          "order": 4,
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Bpmsoft account password for preprod app."
        },
        "clio.bpmSoft.prod.login": {
          "order": 5,
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Bpmsoft account login for prod app."
        },
        "clio.bpmSoft.prod.password": {
          "order": 6,
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Bpmsoft account password for prod app."
        }
      }
    },
    "commands": [
      {
        "command": "cliowrapper.create",
        "title": "Create Package"
      },
      {
        "command": "cliowrapper.createandsend.totest",
        "title": "Bmpsoft Test"
      },
      {
        "command": "cliowrapper.createandsend.topreprod",
        "title": "Bmpsoft Prepod"
      },
      {
        "command": "cliowrapper.createandsend.toprod",
        "title": "Bmpsoft Prod"
      }
    ],
    "submenus": [
      {
        "id": "cliowrapper.submenu",
        "label": "Create Package And Send To"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder",
          "command": "cliowrapper.create",
          "group": "z_cliowrapper"
        },
        {
          "submenu": "cliowrapper.submenu",
          "when": "explorerResourceIsFolder",
          "group": "z_cliowrapper"
        }
      ],
      "cliowrapper.submenu": [
        {
          "command": "cliowrapper.createandsend.totest",
          "when": "isShowTestApp",
          "group": "cliosub@1"
        },
        {
          "command": "cliowrapper.createandsend.topreprod",
          "when": "isShowPreprodApp",
          "group": "cliosub@2"
        },
        {
          "command": "cliowrapper.createandsend.toprod",
          "when": "isShowProdApp",
          "group": "cliosub@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}
