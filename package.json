{
  "name": "cliowrapper",
  "displayName": "Clio Wrapper",
  "description": "Wrapper for CI/CD tools.",
  "icon": "images/icon.png",
  "publisher": "code-papery",
  "version": "1.4.6",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "bpmsoftEnvironment.enable",
        "description": "Color for error message in the status bar.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green"
        }
      },
      {
        "id": "bpmsoftEnvironment.disable",
        "description": "Color for error message in the status bar.",
        "defaults": {
          "dark": "charts.red",
          "light": "charts.red"
        }
      }
    ],
    "views": {
      "scm": [
        {
          "id": "bpmsoftEnvironments",
          "name": "Bpmsoft Environments",
          "contextualTitle": "Environments Explorer"
        },
        {
          "id": "packagesExplorer",
          "name": "Packages Explorer",
          "contextualTitle": "Packages Explorer"
        }
      ]
    },
    "configuration": {
      "title": "Clio wrapper",
      "properties": {
        "clio.outputPath": {
          "order": 0,
          "type": "string",
          "default": "C:\\",
          "scope": "application",
          "description": "Specify output full path for .gz file."
        }
      }
    },
    "commands": [
      {
        "command": "bpmsoftEnvironments.refreshEntry",
        "title": "Refresh"
      },      {
        "command": "packagesExplorer.refreshEntry",
        "title": "Refresh"
      },
      {
        "command": "cliowrapper.package.add.packagesExplorer",
        "title": "Add Folder To Packages Explorer"
      },
      {
        "command": "cliowrapper.package.create",
        "title": "Create Package"
      },
      {
        "command": "cliowrapper.package.createandsend",
        "title": "Create Package And Send"
      },
      {
        "command": "clio.openSettings",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "clio.openLastLog",
        "title": "Open last log",
        "icon": "$(file-binary)"
      },
      {
        "command": "bpmsoftEnvironments.restart",
        "title": "Restart application"
      },
      {
        "command": "bpmsoftEnvironments.redis.clear",
        "title": "Clear redis database"
      },
      {
        "command": "bpmsoftEnvironments.compileConfiguration",
        "title": "Compile configuration"
      },
      {
        "command": "bpmsoftEnvironments.register",
        "title": "Register",
        "icon": "$(plug)"
      },
      {
        "command": "bpmsoftEnvironments.unregister",
        "title": "Unregister",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "packagesExplorer.create",
        "title": "Create package",
        "icon": "$(repo-pull)"
      },
      {
        "command": "packagesExplorer.createandsend",
        "title": "Create and send package",
        "icon": "$(repo-force-push)"
      },
      {
        "command": "packagesExplorer.remove",
        "title": "Remove from Packages Explorer",
        "icon": "$(x)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cliowrapper.package.create",
          "when": "explorerResourceIsFolder && isShowContextMenu",
          "group": "z_cliowrapper@1"
        },
        {
          "command": "cliowrapper.package.createandsend",
          "when": "explorerResourceIsFolder && isShowContextMenu",
          "group": "z_cliowrapper@2"
        },
        {
          "command": "cliowrapper.package.add.packagesExplorer",
          "when": "explorerResourceIsFolder && isShowContextMenu",
          "group": "z_cliowrapper@3"
        }
      ],
      "view/title": [
        {
          "command": "clio.openLastLog",
          "when": "view == bpmsoftEnvironments",
          "group": "navigation@1"
        },
        {
          "command": "clio.openSettings",
          "when": "view == bpmsoftEnvironments",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "bpmsoftEnvironments.restart",
          "when": "view == bpmsoftEnvironments && viewItem == serverTreeItemUnregister",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoftEnvironments.compileConfiguration",
          "when": "view == bpmsoftEnvironments && viewItem == serverTreeItemUnregister",
          "group": "navigation@2"
        },
        {
          "command": "bpmsoftEnvironments.redis.clear",
          "when": "view == bpmsoftEnvironments && viewItem == serverTreeItemUnregister",
          "group": "cw_other@2"
        },
        {
          "command": "bpmsoftEnvironments.register",
          "when": "view == bpmsoftEnvironments && viewItem == serverTreeItemRegister",
          "group": "inline@1"
        },
        {
          "command": "bpmsoftEnvironments.unregister",
          "when": "view == bpmsoftEnvironments && viewItem == serverTreeItemUnregister",
          "group": "inline@2"
        },
        {
          "command": "packagesExplorer.create",
          "when": "view == packagesExplorer && viewItem == packageTreeItemEnable && isShowContextMenu",
          "group": "inline@1"
        },
        {
          "command": "packagesExplorer.createandsend",
          "when": "view == packagesExplorer && viewItem == packageTreeItemEnable && isShowContextMenu",
          "group": "inline@2"
        },
        {
          "command": "packagesExplorer.remove",
          "when": "view == packagesExplorer",
          "group": "pe_other@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}
